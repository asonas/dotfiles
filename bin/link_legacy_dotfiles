#!/bin/bash
set -euo pipefail

repo_root=${1:?repository root is required}
home_dir=${2:-$HOME}
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
link_if_safe="$script_dir/link_if_safe"

required_dirs="
  .zshrc
  .skhdrc
  .yabairc
  .gitignore
  .gitconfig
  .tigrc
  .gemrc
  .irbrc
  .psqlrc
  .tmux.conf
  .config/nvim
  .config/karabiner
  .config/starship.toml
  .config/wezterm
  .config/rubocop
  .config/peco
  .config/htop
  .config/ghostty
  .config/mise/config.toml
  .config/qmd/index.yml

  .claude/commands/gemini-search.md
  .claude/commands/talk-review
  .claude/settings.json
  .claude/scripts
  .claude/rules
"

# Check all managed destinations before changing any of them. This prevents a
# regular user file discovered late in the list from leaving earlier links
# partially updated.
for dir in $required_dirs
do
    link="$home_dir/$dir"
    if [ -e "$link" ] && [ ! -L "$link" ]; then
        echo "error: refusing to replace existing path: $link" >&2
        echo "       remove or move it explicitly before running the installer" >&2
        exit 1
    fi
done

for dir in $required_dirs
do
    target="$repo_root/$dir"
    link="$home_dir/$dir"
    "$link_if_safe" "$target" "$link"
done
